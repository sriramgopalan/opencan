{
  "ignorePatterns": [
    "*.cjs",
    "*.mjs",
    ".lighthouserc.js",
    ".next/",
    "coverage/",
    "playwright-report/",
    "node_modules/",
    "public/"
  ],
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/strict",
    "plugin:import/recommended",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": true
  },
  "plugins": ["@typescript-eslint", "import"],
  "rules": {
    "@typescript-eslint/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ],
    "import/order": [
      "error",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index"
        ],
        "newlines-between": "always",
        "alphabetize": { "order": "asc", "caseInsensitive": true }
      }
    ],
    "import/no-duplicates": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludedFiles": ["**/*.test.ts", "**/*.test.tsx", "src/tests/**", "**/__mocks__/**"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "NewExpression[callee.name='Error']",
            "message": "ADR-002: throw AppError from @/lib/errors instead of new Error()."
          },
          {
            "selector": "CallExpression[callee.name='Error']",
            "message": "ADR-002: throw AppError from @/lib/errors instead of Error()."
          },
          {
            "selector": "CallExpression[callee.object.name='logger'] > ObjectExpression > Property[key.name=/^(email|name|ip|ipAddress|userAgent|password|passwordHash|token|secret|apiKey|to)$/]",
            "message": "privacy.md: banned log field (PII/secret). Log userId or a non-identifying id instead."
          }
        ]
      }
    }
  ],
  "settings": {
    "import/resolver": {
      "typescript": { "alwaysTryTypes": true }
    }
  }
}
